# ==============================================================================
# RANDOO ARCADE — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# For Local Development:
#   Copy this file to .env:
#     cp .env.example .env
#
# For Vercel Deployment (SAFE & RECOMMENDED):
#   Do NOT commit your real .env to GitHub.
#   Instead, add these variables in your Vercel Dashboard:
#     Vercel Dashboard -> Your Project -> Settings -> Environment Variables
# ==============================================================================

# Master 256-bit AES-GCM encryption key for player profiles & leaderboard data
# Tip: Generate a strong random string (e.g. openssl rand -hex 32)
DB_SECRET_KEY=your-secure-database-encryption-key-here

# Cryptographic salt for scrypt key derivation
DB_SALT=your-unique-cryptographic-salt-here

# Secret key used for signing session tokens
SESSION_SECRET=your-session-auth-token-secret-here

# Server port for local development / Node.js servers (default: 8085)
PORT=8085

# Node Environment ('development' or 'production')
NODE_ENV=production

# Optional custom database file path (defaults to data/arcade_database.enc, or /tmp/ on Vercel)
# DB_FILE_PATH=
